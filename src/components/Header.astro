---
import { learningNavTopics, navLinks, siteConfig } from "@/lib/site";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const onBlog = pathname === "/blog" || pathname.startsWith("/blog/");
const blogCluster = onBlog || pathname.startsWith("/learning/");

function isActive(href: string): boolean {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  data-site-header
  class="site-header fixed inset-x-0 top-0 z-[60] h-[calc(3.5rem+env(safe-area-inset-top))] overflow-visible border-b border-transparent bg-transparent pt-[env(safe-area-inset-top)] transition duration-300 sm:h-[calc(4rem+env(safe-area-inset-top))]"
>
  <div class="container-narrow flex h-14 items-center justify-between gap-3 px-4 sm:h-16 sm:gap-4 sm:px-8 lg:px-12">
    <a
      href="/"
      aria-label="Muhammad Shahid, home"
      class="group flex min-w-0 items-center gap-2 font-display text-[0.95rem] font-semibold tracking-tight text-ink transition hover:text-link sm:gap-2.5 sm:text-lg"
    >
      <span
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-teal font-display text-[11px] font-semibold tracking-tight text-cta-ink transition duration-200 group-hover:scale-105"
        aria-hidden="true"
      >
        MS
      </span>
      <span class="truncate">Muhammad Shahid</span>
    </a>

    <nav class="hidden items-center gap-5 lg:flex xl:gap-6" aria-label="Primary">
      {
        navLinks.map((link) => {
          if (link.href === "/blog") {
            return (
              <div class="relative flex items-center gap-0">
                <a
                  href="/blog"
                  class:list={["nav-link hover:text-link", onBlog ? "nav-link-active" : "text-ink-soft"]}
                  aria-current={onBlog ? "page" : undefined}
                >
                  {link.label}
                </a>
                <details class="nav-topics-details">
                  <summary
                    class="nav-link list-none cursor-pointer px-1 hover:text-link"
                    aria-label="Blog topics"
                  >
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 12 12"
                      class="nav-chevron h-3 w-3 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M2.5 4.5 6 8l3.5-3.5" />
                    </svg>
                  </summary>
                  <div class="absolute left-0 top-full z-50 pt-2" role="menu">
                    <div class="max-h-[min(24rem,70vh)] min-w-[230px] overflow-y-auto overscroll-contain rounded-xl border border-slate-line bg-surface-2 py-2 shadow-[0_12px_32px_rgba(15,23,42,0.12)]">
                      <a
                        href="/blog"
                        role="menuitem"
                        class="block px-4 py-2.5 text-sm text-ink-soft hover:bg-paper hover:text-link"
                      >
                        All articles
                      </a>
                      <div class="my-1 border-t border-slate-line" />
                      <p class="px-4 py-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">
                        Topics
                      </p>
                      {
                        learningNavTopics.map((topic) => (
                          <a
                            href={`/learning/${topic.slug}`}
                            role="menuitem"
                            class="block px-4 py-2.5 text-sm text-ink-soft hover:bg-paper hover:text-link"
                          >
                            {topic.label}
                          </a>
                        ))
                      }
                    </div>
                  </div>
                </details>
              </div>
            );
          }
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={["nav-link hover:text-link", active ? "nav-link-active" : "text-ink-soft"]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a href="/contact" class="btn-primary ml-2 !px-4 !py-2 !text-xs">
        {siteConfig.inquiryCta}
      </a>
    </nav>

    <details class="mobile-nav-details lg:hidden">
      <summary
        class="mobile-nav-summary inline-flex h-11 w-11 shrink-0 list-none cursor-pointer items-center justify-center rounded-lg border border-slate-line bg-mist text-ink"
        aria-label="Open menu"
      >
        <span class="sr-only">Open menu</span>
        <span class="relative block h-3.5 w-4" aria-hidden="true">
          <span class="absolute left-0 top-0 block h-0.5 w-4 bg-ink" />
          <span class="absolute left-0 top-1.5 block h-0.5 w-4 bg-ink" />
          <span class="absolute left-0 top-3 block h-0.5 w-4 bg-ink" />
        </span>
      </summary>
      <div
        id="mobile-nav"
        class="mobile-nav-panel fixed inset-x-0 top-[calc(3.5rem+env(safe-area-inset-top))] z-[60] max-h-[min(70dvh,calc(100dvh-3.5rem-env(safe-area-inset-top)))] overflow-y-auto overscroll-contain border-b border-slate-line bg-paper px-4 pb-4 pt-1 shadow-[0_18px_40px_rgba(15,23,42,0.18)] sm:top-[calc(4rem+env(safe-area-inset-top))]"
      >
        <nav class="flex flex-col" aria-label="Mobile">
          {
            navLinks.map((link) => {
              if (link.href === "/blog") {
                return (
                  <div class="border-b border-slate-line/70">
                    <a
                      href="/blog"
                      aria-current={onBlog ? "page" : undefined}
                      class:list={[
                        "flex min-h-12 items-center text-base font-medium hover:text-link",
                        blogCluster ? "text-teal" : "text-ink",
                      ]}
                    >
                      {link.label}
                    </a>
                    <details class="mobile-topics-details border-l border-slate-line pl-3">
                      <summary class="min-h-10 cursor-pointer list-none text-sm text-muted hover:text-link">
                        Topics
                      </summary>
                      <div class="mb-3 flex flex-col">
                        {
                          learningNavTopics.map((topic) => (
                            <a
                              href={`/learning/${topic.slug}`}
                              class="flex min-h-11 items-center text-sm text-muted hover:text-link"
                            >
                              {topic.label}
                            </a>
                          ))
                        }
                      </div>
                    </details>
                  </div>
                );
              }
              const active = isActive(link.href);
              return (
                <a
                  href={link.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "flex min-h-12 items-center border-b border-slate-line/70 text-base font-medium hover:text-link",
                    active ? "text-teal" : "text-ink",
                  ]}
                >
                  {link.label}
                </a>
              );
            })
          }
          <a href="/contact" class="btn-primary mt-4 w-full">
            {siteConfig.inquiryCta}
          </a>
        </nav>
      </div>
    </details>
  </div>
</header>