---
/**
 * Site shell: metadata, JSON-LD, static header, vanilla cookie banner, page scripts.
 */
import "@/styles/fonts.css";
import "@/styles/globals.css";
import Header from "@/components/Header.astro";
import { Footer } from "@/components/Footer";
import { resolveHead, type Metadata } from "@/lib/metadata";
import { personJsonLd, websiteJsonLd } from "@/lib/seo";

interface Props {
  meta: Metadata;
  notFound?: boolean;
  /** Third-party ad slots — blog articles only (keeps marketing pages fast for CWV). */
  showAds?: boolean;
}

const { meta, notFound = false, showAds = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "") || "/";
const tags = resolveHead(meta, { notFound });
---

<!doctype html>
<html lang="en" data-scroll-behavior="smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8fafc" />
    <meta name="color-scheme" content="light" />
    {
      tags.map((t) =>
        t.tag === "title" ? <title>{t.text}</title> : t.tag === "meta" ? <meta {...t.attrs} /> : <link {...t.attrs} />,
      )
    }
    <script is:inline id="consent-default">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });
    </script>
  </head>
  <body class="min-h-screen font-body">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd())} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd())} />
    <Header pathname={pathname} />
    <main id="main-content" tabindex="-1" class="outline-none">
      <slot />
    </main>
    {
      showAds && (
        <div class="container-narrow mx-auto my-8 flex flex-col items-center gap-6 px-4" aria-hidden="true">
          <div class="hidden md:block" style="width:728px;height:90px" data-adsterra-banner="e7d3fc22f1efd14ae0ffc060a52c53ad" data-w="728" data-h="90"></div>
          <div class="md:hidden" style="width:320px;height:50px" data-adsterra-banner="89bab677a327de32f507e4ac3c3f3fab" data-w="320" data-h="50"></div>
          <div class="w-full" data-adsterra-native="6cc1f57c78ab2a188865ea56c11ea56d"></div>
        </div>
      )
    }
    <Footer />

    <div
      id="cookie-consent"
      hidden
      class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-line bg-surface-2/95 p-4 pb-[max(1rem,env(safe-area-inset-bottom))] shadow-[0_-8px_30px_rgba(15,23,42,0.1)] backdrop-blur-sm sm:p-5"
      role="dialog"
      aria-labelledby="cookie-consent-title"
    >
      <div class="container-narrow flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-2xl text-sm text-ink-soft">
          <p id="cookie-consent-title" class="font-semibold text-ink">Cookies, analytics &amp; ads</p>
          <p class="mt-1">
            This site uses cookies for analytics and personalized ads (Google AdSense) if you accept. You
            can reject non-essential cookies. <a href="/privacy" class="font-semibold link-underline">Privacy</a>
            {" · "}
            <a href="/terms" class="font-semibold link-underline">Terms</a>
            {" · "}
            <a href="/contact" class="font-semibold link-underline">Contact</a>.
          </p>
        </div>
        <div class="flex w-full shrink-0 flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap">
          <button type="button" data-consent="rejected" class="btn-secondary w-full !py-2.5 !text-sm sm:w-auto">
            Reject
          </button>
          <button type="button" data-consent="accepted" class="btn-primary w-full !py-2.5 !text-sm sm:w-auto">
            Accept
          </button>
        </div>
      </div>
    </div>

    <script>
      import "@/scripts/header";
      import "@/scripts/cookie-banner";
      import "@/scripts/site";
      import "@/scripts/consent-scripts";
    </script>
  </body>
</html>