{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "muhammadshahid.dev" }],
      "destination": "https://www.muhammadshahid.dev/:path*",
      "permanent": true
    },
    { "source": "/learning", "destination": "/blog", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    {
      "source": "/blog/modular-monolith-vs-microservices",
      "destination": "/blog/modular-monolith-vs-microservices-dotnet",
      "permanent": true
    },
    { "source": "/sitemap", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/rss", "destination": "/rss.xml", "permanent": true },
    { "source": "/feed", "destination": "/rss.xml", "permanent": true },
    { "source": "/%24", "destination": "/", "permanent": true },
    { "source": "/\\$", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/sitemap.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/robots.txt", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/rss.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    {
      "source": "/:path(.*\\.(?:svg|png|jpg|jpeg|gif|webp|ico|txt|xml))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(icon|opengraph-image)",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, immutable, no-transform, max-age=31536000" }
      ]
    },
    {
      "source": "/blog/:slug/opengraph-image",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, immutable, no-transform, max-age=31536000" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
