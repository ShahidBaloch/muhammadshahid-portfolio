# Public site URL (used for sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://muhammadshahid.dev

# Google Search Console — paste the content value from the HTML tag meta verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense client ID after approval (e.g. ca-pub-xxxxxxxxxxxxxxxx)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Also update public/ads.txt with:
# google.com, pub-XXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0

# Contact form SMTP (required for /api/contact)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# Do NOT set CONTACT_TO to info@… if that address Cloudflare-routes back to the
# same Gmail used as SMTP_USER — Gmail hides those as duplicates. With Gmail SMTP
# the API delivers to SMTP_USER automatically.
# CONTACT_TO=your@gmail.com
# Optional From address. Defaults to SMTP_USER. With Gmail SMTP, only set this
# after adding the address under Gmail → Settings → Accounts → Send mail as.
# CONTACT_FROM=info@muhammadshahid.dev
